{
  "name": "vercel-axi",
  "version": "0.1.0",
  "description": "AXI-compliant, agent-ergonomic wrapper for the official Vercel CLI",
  "type": "module",
  "bin": {
    "vercel-axi": "bin/vercel-axi.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "prebuild": "npm run clean",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "prepack": "npm run build && npm run skill:gen",
    "pretest": "npm run build",
    "test": "vitest run",
    "skill:gen": "node scripts/gen-skill.mjs",
    "skill:check": "node scripts/gen-skill.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "axi-axi": "0.1.0",
    "typescript": "^5.6.0",
    "vercel": "59.10.0",
    "vitest": "4.1.11"
  }
}
